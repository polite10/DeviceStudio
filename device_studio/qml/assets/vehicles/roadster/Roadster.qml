pragma ComponentBehavior: Bound
import QtQuick
import QtQuick3D

// Generated by tools/build_roadster_model.py from tools/roadster_blender.py:
// 2028 Tesla Roadster style flying hypercar in metres, +Z forward, ground at y = 0.
// Same contract as the other Studio cars plus thrust, boost and wing; no badges or logos.
Node {
    id: root
    property color paint: "#eef0f1"
    property real metallic: 0.05
    property bool braking: false
    property real lamps: 0.35
    property real wheelAngle: 0
    // Positive pitch dives the nose; positive roll leans toward the car's right.
    property real bodyPitch: 0
    property real bodyRoll: 0
    // 0..1: lift nozzles behind the wheels and the nose yaw nozzles fire.
    property real thrust: 0
    // 0..1: the four rear nozzles fire backwards.
    property real boost: 0
    // 0 flush with the tail .. 1 raised on its stabilisers.
    property real wing: 0

    PrincipledMaterial {
        id: paintMaterial
        baseColor: root.paint
        metalness: root.metallic
        roughness: 0.26
        clearcoatAmount: 1
        clearcoatRoughnessAmount: 0.03
    }
    PrincipledMaterial {
        // Gold tinted glass, like a spacesuit visor.
        id: glassMaterial
        baseColor: "#6a5218"; roughness: 0.04; metalness: 0.8; specularAmount: 1
        clearcoatAmount: 1; clearcoatRoughnessAmount: 0.02
        alphaMode: PrincipledMaterial.Blend; opacity: 0.9
    }
    PrincipledMaterial { id: glossBlackMaterial; baseColor: "#08090a"; roughness: 0.14; clearcoatAmount: 1; clearcoatRoughnessAmount: 0.05 }
    PrincipledMaterial { id: trimMaterial; baseColor: "#121315"; roughness: 0.6 }
    PrincipledMaterial { id: underMaterial; baseColor: "#0b0b0c"; roughness: 0.92 }
    PrincipledMaterial { id: lampDarkMaterial; baseColor: "#16191c"; metalness: 0.7; roughness: 0.16; clearcoatAmount: 1 }
    PrincipledMaterial {
        id: headlightMaterial
        baseColor: "#f1f5f8"; roughness: 0.08; metalness: 0.1
        emissiveFactor: Qt.vector3d(root.lamps * 3.4, root.lamps * 3.5, root.lamps * 3.7)
    }
    PrincipledMaterial {
        id: tailMaterial
        baseColor: root.braking ? "#ff3340" : "#6a0b14"; roughness: 0.2
        emissiveFactor: root.braking ? Qt.vector3d(6.5, 0.2, 0.15) : Qt.vector3d(root.lamps * 1.6, 0.02, 0.02)
    }
    PrincipledMaterial { id: signalMaterial; baseColor: "#e48a1c"; roughness: 0.22; emissiveFactor: Qt.vector3d(0.15, 0.06, 0) }
    PrincipledMaterial { id: fanMaterial; baseColor: "#1b1f24"; metalness: 0.8; roughness: 0.3 }
    PrincipledMaterial {
        id: thrusterMaterial
        baseColor: "#2a3037"; metalness: 0.9; roughness: 0.25
        emissiveFactor: Qt.vector3d(2.2, 2.8, 3.6).times(Math.max(root.thrust, root.boost))
    }
    PrincipledMaterial { id: wingMaterial; baseColor: root.paint; metalness: root.metallic; roughness: 0.26; clearcoatAmount: 1 }
    PrincipledMaterial { id: plateMaterial; baseColor: "#f4f4ef"; roughness: 0.5 }
    PrincipledMaterial { id: plateTextMaterial; baseColor: "#101010"; roughness: 0.5 }
    PrincipledMaterial { id: plateBandMaterial; baseColor: "#1f4fa8"; roughness: 0.5 }
    PrincipledMaterial { id: interiorMaterial; baseColor: "#1d1e21"; roughness: 0.8 }
    PrincipledMaterial { id: tyreMaterial; baseColor: "#141515"; roughness: 0.86 }
    PrincipledMaterial { id: rimMaterial; baseColor: "#1c1d20"; metalness: 0.5; roughness: 0.45 }
    PrincipledMaterial { id: aeroMaterial; baseColor: "#24272b"; metalness: 0.7; roughness: 0.3 }
    PrincipledMaterial { id: aeroAccentMaterial; baseColor: "#b9c0c7"; metalness: 0.9; roughness: 0.25 }
    PrincipledMaterial { id: capMaterial; baseColor: "#0c0d0f"; roughness: 0.2; clearcoatAmount: 1 }
    PrincipledMaterial {
        // Cold nitrogen jets: pale, translucent, unlit.
        id: plumeMaterial
        baseColor: "#e8f0f8"; lighting: PrincipledMaterial.NoLighting
        alphaMode: PrincipledMaterial.Blend; opacity: 0.3
    }

    Node {
        // The body rotates around its suspension centre; wheels stay on the road.
        position: Qt.vector3d(0, 0.45, 0)
        pivot: Qt.vector3d(0, 0.45, 0)
        eulerRotation: Qt.vector3d(root.bodyPitch, 0, -root.bodyRoll)
        Model { source: "meshes/roadsterFan_mesh.mesh"; materials: fanMaterial }
        Model { source: "meshes/roadsterGlass_mesh.mesh"; materials: glassMaterial }
        Model { source: "meshes/roadsterGlossBlack_mesh.mesh"; materials: glossBlackMaterial }
        Model { source: "meshes/roadsterHeadlight_mesh.mesh"; materials: headlightMaterial }
        Model { source: "meshes/roadsterInterior_mesh.mesh"; materials: interiorMaterial }
        Model { source: "meshes/roadsterLampDark_mesh.mesh"; materials: lampDarkMaterial }
        Model { source: "meshes/roadsterPaint_mesh.mesh"; materials: paintMaterial }
        Model { source: "meshes/roadsterPlate_mesh.mesh"; materials: plateMaterial }
        Model { source: "meshes/roadsterPlateBand_mesh.mesh"; materials: plateBandMaterial }
        Model { source: "meshes/roadsterPlateText_mesh.mesh"; materials: plateTextMaterial }
        Model { source: "meshes/roadsterSignal_mesh.mesh"; materials: signalMaterial }
        Model { source: "meshes/roadsterTailLight_mesh.mesh"; materials: tailMaterial }
        Model { source: "meshes/roadsterThruster_mesh.mesh"; materials: thrusterMaterial }
        Model { source: "meshes/roadsterTrim_mesh.mesh"; materials: trimMaterial }
        Model { source: "meshes/roadsterUnder_mesh.mesh"; materials: underMaterial }
        Node {
            // The tail section rises on its stabiliser fins.
            y: root.wing * 0.2
            Model { source: "meshes/roadsterWing_mesh.mesh"; materials: wingMaterial }
        }
        // Jets grow from each nozzle: #Cone points up with its tip at +50.
        Repeater3D {
            model: [[0.700, 0.118, 0.900], [-0.700, 0.118, 0.900], [0.700, 0.118, -1.925], [-0.700, 0.118, -1.925]]
            delegate: Model {
                required property var modelData
                source: "#Cone"
                visible: root.thrust > 0.02
                position: Qt.vector3d(modelData[0], modelData[1] - 0.5 * root.thrust, modelData[2])
                scale: Qt.vector3d(0.0016 + 0.0014 * root.thrust, 0.01 * root.thrust, 0.0016 + 0.0014 * root.thrust)
                castsShadows: false; receivesShadows: false
                materials: plumeMaterial
            }
        }
        Repeater3D {
            model: [[0.965, 0.430, 1.950], [-0.965, 0.430, 1.950]]
            delegate: Model {
                required property var modelData
                source: "#Cone"
                visible: root.thrust > 0.02
                position: Qt.vector3d(modelData[0] + Math.sign(modelData[0]) * 0.18 * root.thrust, modelData[1], modelData[2])
                eulerRotation.z: modelData[0] > 0 ? 90 : -90
                scale: Qt.vector3d(0.001 + 0.001 * root.thrust, 0.0036 * root.thrust, 0.001 + 0.001 * root.thrust)
                castsShadows: false; receivesShadows: false
                materials: plumeMaterial
            }
        }
        Repeater3D {
            model: [[0.700, 0.700, -2.246], [0.550, 0.700, -2.246], [-0.550, 0.700, -2.246], [-0.700, 0.700, -2.246]]
            delegate: Model {
                required property var modelData
                source: "#Cone"
                visible: root.boost > 0.02
                position: Qt.vector3d(modelData[0], modelData[1], modelData[2] - 0.45 * root.boost)
                eulerRotation.x: 90
                scale: Qt.vector3d(0.0012 + 0.0012 * root.boost, 0.009 * root.boost, 0.0012 + 0.0012 * root.boost)
                castsShadows: false; receivesShadows: false
                materials: plumeMaterial
            }
        }
    }
    Repeater3D {
        model: [[0.855, 1.400], [-0.855, 1.400], [0.855, -1.425], [-0.855, -1.425]]
        delegate: Node {
            required property var modelData
            position: Qt.vector3d(modelData[0], 0.355, modelData[1])
            eulerRotation.x: -root.wheelAngle
            Model { source: "meshes/roadsterWheelAero_mesh.mesh"; materials: aeroMaterial }
            Model { source: "meshes/roadsterWheelAeroAccent_mesh.mesh"; materials: aeroAccentMaterial }
            Model { source: "meshes/roadsterWheelCap_mesh.mesh"; materials: capMaterial }
            Model { source: "meshes/roadsterWheelRim_mesh.mesh"; materials: rimMaterial }
            Model { source: "meshes/roadsterWheelTyre_mesh.mesh"; materials: tyreMaterial }
        }
    }
}

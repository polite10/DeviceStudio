; ADASLab Drive: standalone 3D display and keyboard front end.
config_version=5

[application]
config/name="ADASLab Drive"
run/main_scene="res://main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Three-dimensional traffic display for Device Studio and STM32 ADASLab"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1000
window/size/min_height=680
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.macos="forward_plus"
rendering_device/driver.macos="metal"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=2048
viewport/hdr_2d=false
